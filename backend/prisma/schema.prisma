generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Producto {
  id              Int          @id @default(autoincrement())
  categoria       String
  producto        String
  unidad          String       @default("Unidad")
  stockCompleto   Int          @default(0)
  stockIncompleto Int          @default(0)
  stockMinimo     Int          @default(0)
  unidadesPorPaquete Int       @default(1) // cuántas unidades trae un paquete (para solicitudes por paquete)
  precio          Float        @default(0) // precio unitario
  solicitable     Boolean      @default(false)
  movimientos     Movimiento[]
  ticketItems     TicketItem[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Listado paginado: filtro por categoría + orden estable por nombre/id.
  @@index([categoria, producto, id])
}

model Movimiento {
  id            Int      @id @default(autoincrement())
  productoId    Int
  producto      Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tipo          String // ENTRADA | SALIDA
  cantidad      Int
  destino       String? // tienda o área a la que se entregó (salida)
  responsable   String?
  observacion   String?
  fecha         DateTime @default(now())
  compraId      Int? // si esta ENTRADA vino de una Compra registrada (línea de esa compra)
  compra        Compra?  @relation(fields: [compraId], references: [id], onDelete: SetNull)
  precioUnitario Float? // costo de compra de esta línea (solo informativo, no toca Producto.precio)

  // Historial filtrado por producto y fecha.
  @@index([productoId, fecha, id])
  @@index([fecha, id])
  @@index([tipo, fecha, id])
  @@index([compraId])
}

// Compra a un proveedor, agrupando una o más entradas de stock (Movimiento
// tipo ENTRADA) para poder ver cuánto se gastó y en qué, sin afectar el
// precio de venta del producto (ese se sigue editando aparte, a mano).
model Compra {
  id           Int          @id @default(autoincrement())
  proveedor    String
  comprobante  String? // número de boleta/factura, opcional
  observacion  String?
  total        Float // suma de cantidad * precioUnitario de sus líneas, calculada al crear
  registradoPor String
  movimientos  Movimiento[]
  fecha        DateTime     @default(now())

  @@index([fecha, id])
}

model Usuario {
  id                    Int         @id @default(autoincrement())
  username              String      @unique
  nombre                String
  passwordHash          String
  rol                   String      @default("usuario") // admin | usuario | tienda | lider
  tienda                String? // nombre de la tienda (para usuarios rol "tienda")
  area                  String? // área (para usuarios rol "lider": RR.HH | Marketing | Logística | Sistemas)
  activo                Boolean     @default(true)
  ultimoLogin           DateTime?
  ultimaIp              String?
  createdAt             DateTime    @default(now())
  actividades           Actividad[]
  ticketsSolicitados    Ticket[]    @relation("ticketSolicitante")
  ticketsAtendidos      Ticket[]    @relation("ticketAtendido")
  traspasosSolicitados  Traspaso[]  @relation("traspasoSolicitante")
  traspasosAtendidos    Traspaso[]  @relation("traspasoAtendido")
  pushSuscripciones     PushSuscripcion[]
}

// Suscripción push del navegador de un usuario (uno por dispositivo/navegador).
// El endpoint es único: si el usuario se vuelve a suscribir desde el mismo
// navegador, se reemplaza en vez de duplicar.
model PushSuscripcion {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

model Actividad {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  accion    String
  detalle   String?
  ip        String?
  fecha     DateTime @default(now())

  @@index([usuarioId, id])
  @@index([fecha, id])
  @@index([accion, id]) // historial ERP de traspasos: filtra por accion ("ERP traspaso <id>")
}

model Ticket {
  id              Int          @id @default(autoincrement())
  area            String? // área o motivo de la solicitud (texto libre)
  nota            String?
  estado          String       @default("PENDIENTE") // PENDIENTE | APROBADO | ENTREGADO | RECHAZADO
  solicitanteId   Int
  solicitante     Usuario      @relation("ticketSolicitante", fields: [solicitanteId], references: [id], onDelete: Cascade)
  atendidoPorId   Int?
  atendidoPor     Usuario?     @relation("ticketAtendido", fields: [atendidoPorId], references: [id])
  motivoRechazo   String?
  observacionAdmin String? // criterio / nota del admin al aprobar o entregar (ej. por qué ajustó cantidades)
  items           TicketItem[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Listados paginados del solicitante y de administración.
  @@index([solicitanteId, createdAt, id])
  @@index([solicitanteId, estado, createdAt, id])
  @@index([estado, createdAt, id])
  @@index([createdAt, id])
}

// Traspaso de un producto entre dos tiendas, negociado directamente entre
// ellas (sin pasar por almacén ni por el catálogo de Producto: es una
// descripción libre, porque suele tratarse de artículos externos al
// inventario). El admin/almacén solo lo mira para replicarlo en el ERP real;
// `copiadoErp` es su checklist personal, no bloquea nada del flujo.
model Traspaso {
  id             Int      @id @default(autoincrement())
  origenTienda   String // tienda que crea el traspaso y lo envía
  destinoTienda  String // tienda que debe aceptarlo
  producto       String // descripción libre (no ligado al catálogo de Producto)
  codigoProducto String // código/SKU del producto, para calzar con el ERP real
  cantidad       Int
  unidad         String?
  nota           String?
  fotoUrl        String? // opcional, evidencia del producto
  estado         String   @default("PENDIENTE") // PENDIENTE | ACEPTADO | RECHAZADO | CANCELADO
  motivoRechazo  String?
  copiadoErp     Boolean  @default(false) // admin/almacén: ya lo replicó en el ERP real
  solicitanteId  Int
  solicitante    Usuario  @relation("traspasoSolicitante", fields: [solicitanteId], references: [id], onDelete: Cascade)
  atendidoPorId  Int?
  atendidoPor    Usuario? @relation("traspasoAtendido", fields: [atendidoPorId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Listados por tienda (origen o destino) y por estado.
  @@index([origenTienda, createdAt, id])
  @@index([destinoTienda, createdAt, id])
  @@index([estado, createdAt, id])
  @@index([createdAt, id])
}

model TicketItem {
  id               Int      @id @default(autoincrement())
  ticketId         Int
  ticket           Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  productoId       Int
  producto         Producto @relation(fields: [productoId], references: [id])
  cantidad         Int // cantidad solicitada por la tienda/área (en unidades o paquetes según enPaquetes)
  cantidadAprobada Int? // cantidad ajustada por el admin (si es null, se usa la solicitada)
  enPaquetes       Boolean  @default(false) // si true, cantidad/cantidadAprobada están en paquetes

  @@index([ticketId])
  @@index([productoId])
}
